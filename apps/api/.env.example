APP_NAME=Lary 2 MVP 0.1
APP_ENV=development
CORS_ORIGINS=*
DATABASE_URL=postgresql://user:password@host:5432/database
FILE_STORAGE_DIR=/tmp/lary-generated

GIGACHAT_CREDENTIALS=PASTE_GIGACHAT_AUTHORIZATION_KEY_HERE
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL_CERTS=false
GIGACHAT_TIMEOUT=60.0
GIGACHAT_MAX_RETRIES=3

SALUTE_SPEECH_AUTHORIZATION_KEY=PASTE_SALUTESPEECH_AUTHORIZATION_KEY_HERE
SALUTE_SPEECH_SCOPE=SALUTE_SPEECH_PERS
SALUTE_SPEECH_VERIFY_SSL_CERTS=false
SPEECH_PROVIDER=salute
VOSK_MODEL_PATH=/app/models/vosk-model-small-ru-0.22
VOSK_MODEL_URL=https://alphacephei.com/vosk/models/vosk-model-small-ru-0.22.zip
VOSK_AUTO_DOWNLOAD=false

PAYMENT_PROVIDER_MODE=placeholder
