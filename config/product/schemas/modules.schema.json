{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lary.pro/schemas/product/modules.schema.json",
  "title": "LARI module registry",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slug", "status", "category", "title", "promise", "duration", "output_formats", "feature_flags"],
    "properties": {
      "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
      "status": {"enum": ["active", "preparing", "hidden"]},
      "category": {"type": "string", "minLength": 1},
      "title": {"type": "string", "minLength": 1},
      "promise": {"type": "string", "minLength": 1},
      "duration": {"type": "string", "minLength": 1},
      "output_formats": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"enum": ["docx", "pptx", "xlsx", "zip"]}
      },
      "feature_flags": {
        "type": "object",
        "additionalProperties": {"type": "boolean"}
      }
    }
  }
}
