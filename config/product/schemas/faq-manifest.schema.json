{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lary.pro/schemas/product/faq-manifest.schema.json",
  "title": "LARI FAQ pack manifest",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "faq_pack_id",
      "module_slug",
      "contest_slug",
      "version",
      "categories",
      "entries",
      "migration_status",
      "updated_at"
    ],
    "properties": {
      "faq_pack_id": {"type": "string", "minLength": 1},
      "module_slug": {"type": "string", "minLength": 1},
      "contest_slug": {"type": "string", "minLength": 1},
      "version": {"type": "string", "minLength": 1},
      "categories": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["question", "answer", "category"],
          "properties": {
            "question": {"type": "string"},
            "answer": {"type": "string"},
            "category": {"type": "string"}
          }
        }
      },
      "migration_status": {"enum": ["legacy_help", "versioned_faq"]},
      "updated_at": {"type": "string", "format": "date"}
    }
  }
}
